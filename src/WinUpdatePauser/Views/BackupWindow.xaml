<Window x:Class="WinUpdatePauser.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份管理"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Width="560"
        Height="520"
        MinWidth="500"
        MinHeight="440"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource TitleText}" Text="备份管理" />
        <TextBlock Grid.Row="1"
                   Style="{StaticResource CaptionText}"
                   Margin="0,4,0,12"
                   Text="每次注册表修改前自动保存原始值；可恢复、重命名或删除备份。" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <ListBox x:Name="BackupList"
                     BorderThickness="0"
                     Background="Transparent"
                     SelectionChanged="BackupList_SelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,5">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                       Margin="0,2,0,0"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="RenameBox"
                     Grid.Column="0"
                     Style="{StaticResource InputBox}"
                     ToolTip="选中备份后输入新名称" />
            <Button Grid.Column="2"
                    Style="{StaticResource SecondaryButton}"
                    Content="恢复"
                    Click="Restore_Click" />
            <Button Grid.Column="4"
                    Style="{StaticResource SecondaryButton}"
                    Content="重命名"
                    Click="Rename_Click" />
            <Button Grid.Column="6"
                    Style="{StaticResource SecondaryButton}"
                    Content="删除"
                    Click="Delete_Click" />
        </Grid>

        <TextBlock Grid.Row="4"
                   Style="{StaticResource CaptionText}"
                   Margin="0,14,0,4"
                   Text="当前备份路径（默认：程序目录下的 backup）" />
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BackupPathBox"
                     Grid.Column="0"
                     Style="{StaticResource InputBox}"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="2"
                    Style="{StaticResource SecondaryButton}"
                    Content="浏览"
                    Click="BrowsePath_Click" />
            <Button Grid.Column="4"
                    Style="{StaticResource SecondaryButton}"
                    Content="应用路径"
                    Click="ApplyPath_Click" />
        </Grid>

        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Style="{StaticResource SecondaryButton}"
                    Content="恢复默认路径"
                    Click="ResetPath_Click" />
            <Button Grid.Column="2"
                    Style="{StaticResource SecondaryButton}"
                    Content="打开文件夹"
                    Click="OpenFolder_Click" />
            <Button Grid.Column="4"
                    Style="{StaticResource PrimaryButton}"
                    Content="关闭"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
