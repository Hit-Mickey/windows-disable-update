<UserControl x:Class="WinUpdatePauser.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 主页：显示当前暂停状态 + 选择新的暂停结束时间并应用 -->
    <StackPanel Margin="24">

        <!-- 标题 -->
        <TextBlock Style="{StaticResource TitleText}" Text="Windows 更新暂停助手" />
        <TextBlock Style="{StaticResource CaptionText}"
                   Margin="0,4,0,16"
                   Text="修改 Windows 更新的暂停结束日期，无需手动编辑注册表" />

        <!-- 系统信息与配置方式切换：仅显示当前选中的配置面板 -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="SystemVersionText"
                           Style="{StaticResource CaptionText}"
                           Text="正在检测系统版本…" />
                <TextBlock x:Name="ModeHintText"
                           Style="{StaticResource CaptionText}"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource AccentBrush}"
                           Text="默认使用新版日期配置，可按实际界面切换旧版" />
            </StackPanel>
            <Button x:Name="ModeSwitchButton"
                    Grid.Column="1"
                    Style="{StaticResource SecondaryButton}"
                    Margin="12,0,0,0"
                    Content="切换配置方式"
                    Click="ModeSwitch_Click" />
        </Grid>

        <!-- 状态卡片 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="当前状态" />
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               x:Name="RegistryStateLabel"
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="注册表状态：" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="RegistryStateText"
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource SuccessBrush}"
                               Text="√ 已初始化" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Margin="0,6,0,0"
                               x:Name="CurrentStatusLabel"
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="当前暂停更新时间：" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               x:Name="CurrentStatusValue"
                               Margin="0,6,0,0"
                               Style="{StaticResource BodyText}"
                               FontWeight="SemiBold"
                               Text="—" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 日期设置卡片 -->
        <Border x:Name="NewCalendarPanel" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="选择新的暂停结束时间" />

                <!-- 年/月/日/时/分 手动输入 -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBox x:Name="YearBox"
                             Style="{StaticResource InputBox}"
                             Width="64" MaxLength="4"
                             TextChanged="Input_Changed"
                             PreviewTextInput="Input_DigitsOnly" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="6,0,14,0" VerticalAlignment="Center" Text="年" />

                    <TextBox x:Name="MonthBox"
                             Style="{StaticResource InputBox}"
                             Width="44" MaxLength="2"
                             TextChanged="Input_Changed"
                             PreviewTextInput="Input_DigitsOnly" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="6,0,14,0" VerticalAlignment="Center" Text="月" />

                    <TextBox x:Name="DayBox"
                             Style="{StaticResource InputBox}"
                             Width="44" MaxLength="2"
                             TextChanged="Input_Changed"
                             PreviewTextInput="Input_DigitsOnly" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="6,0,20,0" VerticalAlignment="Center" Text="日" />

                    <TextBox x:Name="HourBox"
                             Style="{StaticResource InputBox}"
                             Width="44" MaxLength="2"
                             TextChanged="Input_Changed"
                             PreviewTextInput="Input_DigitsOnly" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="6,0,14,0" VerticalAlignment="Center" Text="时" />

                    <TextBox x:Name="MinuteBox"
                             Style="{StaticResource InputBox}"
                             Width="44" MaxLength="2"
                             TextChanged="Input_Changed"
                             PreviewTextInput="Input_DigitsOnly" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="6,0,0,0" VerticalAlignment="Center" Text="分" />
                </StackPanel>

                <!-- 校验提示（不合法时显示原因并禁用应用按钮） -->
                <TextBlock x:Name="ValidationText"
                           Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0"
                           Text="可填范围：明天 ~ 2199-12-31" />

                <!-- 应用按钮 -->
                <Button x:Name="ApplyButton"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"
                        Content="应用暂停日期"
                        Click="Apply_Click" />
            </StackPanel>
        </Border>

        <!-- 旧版配置面板：与新版面板互斥显示 -->
        <Border x:Name="LegacyPanel"
                Style="{StaticResource Card}"
                Margin="0,12,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="旧版暂停天数" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBox x:Name="LegacyDaysBox"
                             Style="{StaticResource InputBox}"
                             Width="100"
                             MaxLength="5"
                             TextChanged="LegacyInput_Changed"
                             PreviewTextInput="Input_DigitsOnly" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="天" />
                </StackPanel>
                <TextBlock x:Name="LegacyValidationText"
                           Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0"
                           Text="可填范围：1 ~ 36500 天" />
                <Button x:Name="ApplyLegacyButton"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"
                        Content="应用旧版暂停天数"
                        Click="ApplyLegacy_Click" />
            </StackPanel>
        </Border>

        <!-- 底部操作 -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Style="{StaticResource SecondaryButton}"
                    Content="恢复正常更新"
                    Click="Resume_Click" />
            <Button Grid.Column="2"
                    Style="{StaticResource SecondaryButton}"
                    Content="备份管理"
                    Click="ManageBackups_Click" />
            <Button Grid.Column="4"
                    Style="{StaticResource SecondaryButton}"
                    Content="打开更新设置"
                    Click="OpenSettings_Click" />
        </Grid>

        <TextBlock Style="{StaticResource CaptionText}"
                   Margin="0,10,0,0"
                   Text="新版可在「设置 → Windows 更新」中查看暂停日期；旧版通过暂停天数控制。" />

    </StackPanel>
</UserControl>
