<UserControl x:Class="WinUpdatePauser.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 主页：显示当前暂停状态 + 选择新的暂停结束时间并应用 -->
    <StackPanel Margin="24">

        <!-- 标题 -->
        <TextBlock Style="{StaticResource TitleText}" Text="Windows 更新暂停助手" />
        <TextBlock Style="{StaticResource CaptionText}"
                   Margin="0,4,0,16"
                   Text="修改 Windows 更新的暂停结束日期，无需手动编辑注册表" />

        <!-- 状态卡片 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="当前状态" />
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="注册表状态：" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="RegistryStateText"
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource SuccessBrush}"
                               Text="√ 已初始化" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Margin="0,6,0,0"
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="当前暂停更新时间：" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               x:Name="CurrentEndTimeText"
                               Margin="0,6,0,0"
                               Style="{StaticResource BodyText}"
                               FontWeight="SemiBold"
                               Text="—" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 日期设置卡片 -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="选择新的暂停结束时间" />

                <!-- 年/月/日/时/分 手动输入 -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBox x:Name="YearBox"
                             Style="{StaticResource InputBox}"
                             Width="64" MaxLength="4"
                             TextChanged="Input_Changed"
                             PreviewTextInput="Input_DigitsOnly" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="6,0,14,0" VerticalAlignment="Center" Text="年" />

                    <TextBox x:Name="MonthBox"
                             Style="{StaticResource InputBox}"
                             Width="44" MaxLength="2"
                             TextChanged="Input_Changed"
                             PreviewTextInput="Input_DigitsOnly" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="6,0,14,0" VerticalAlignment="Center" Text="月" />

                    <TextBox x:Name="DayBox"
                             Style="{StaticResource InputBox}"
                             Width="44" MaxLength="2"
                             TextChanged="Input_Changed"
                             PreviewTextInput="Input_DigitsOnly" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="6,0,20,0" VerticalAlignment="Center" Text="日" />

                    <TextBox x:Name="HourBox"
                             Style="{StaticResource InputBox}"
                             Width="44" MaxLength="2"
                             TextChanged="Input_Changed"
                             PreviewTextInput="Input_DigitsOnly" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="6,0,14,0" VerticalAlignment="Center" Text="时" />

                    <TextBox x:Name="MinuteBox"
                             Style="{StaticResource InputBox}"
                             Width="44" MaxLength="2"
                             TextChanged="Input_Changed"
                             PreviewTextInput="Input_DigitsOnly" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="6,0,0,0" VerticalAlignment="Center" Text="分" />
                </StackPanel>

                <!-- 校验提示（不合法时显示原因并禁用应用按钮） -->
                <TextBlock x:Name="ValidationText"
                           Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0"
                           Text="可填范围：明天 ~ 2099-12-31" />

                <!-- 应用按钮 -->
                <Button x:Name="ApplyButton"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"
                        Content="应用暂停日期"
                        Click="Apply_Click" />
            </StackPanel>
        </Border>

        <!-- 底部说明 -->
        <TextBlock Style="{StaticResource CaptionText}"
                   Margin="0,12,0,0"
                   Text="应用后可在「设置 → Windows 更新」中查看暂停日期。如需恢复正常更新，在系统设置中点击「继续更新」即可。" />

    </StackPanel>
</UserControl>
